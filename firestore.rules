rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isHr() {
      return signedIn() && callerRole() in ['SUPER_ADMIN', 'HR'];
    }

    function isSuperAdmin() {
      return signedIn() && callerRole() == 'SUPER_ADMIN';
    }

    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validSelfProfileUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && request.auth.uid == userId
        && changed.hasOnly(['phone', 'address', 'photoPath'])
        && (!changed.hasAny(['phone'])
          || (request.resource.data.phone is string
            && request.resource.data.phone.matches('^\\+?[0-9][0-9 ()-]{6,18}$')))
        && (!changed.hasAny(['address'])
          || (request.resource.data.address is string
            && request.resource.data.address.size() <= 300))
        && (!changed.hasAny(['photoPath'])
          || (request.resource.data.photoPath is string
            && request.resource.data.photoPath.matches(
              '^profile-photos/' + userId + '/[0-9]+$'
            )));
    }

    function validEmploymentUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isHr()
        && changed.hasOnly([
          'fullName',
          'employeeId',
          'birthday',
          'dateOfJoining',
          'department',
          'designation',
          'reportingManager',
          'workLocation',
          'employmentType',
          'employmentStatus',
          'role'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.employeeId is string
        && request.resource.data.department is string
        && request.resource.data.designation is string
        && request.resource.data.reportingManager is string
        && request.resource.data.workLocation is string
        && request.resource.data.employmentType in ['Full-time', 'Contract', 'Intern']
        && request.resource.data.employmentStatus in ['Probation', 'Active', 'Inactive']
        && validDate(request.resource.data.dateOfJoining)
        && (request.resource.data.birthday == null
          || validDate(request.resource.data.birthday))
        && (!changed.hasAny(['role'])
          || (isSuperAdmin()
            && request.auth.uid != userId
            && request.resource.data.role in ['SUPER_ADMIN', 'HR', 'EMPLOYEE']));
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isHr();
      allow create, delete: if false;
      allow update: if validSelfProfileUpdate(userId)
        || validEmploymentUpdate(userId);
    }

    match /hrmsSettings/{settingId} {
      allow get: if signedIn() && settingId in ['attendance', 'company'];
      allow list, create, update, delete: if false;
    }

    match /attendance/{attendanceId} {
      allow get, list: if signedIn()
        && (resource.data.uid == request.auth.uid || isHr());
      allow create, update, delete: if false;
    }

    match /employeeDocuments/{documentId} {
      allow get, list: if signedIn()
        && (isHr()
          || (resource.data.employeeUid == request.auth.uid
            && resource.data.status == 'approved'));
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
